{% assign trophy_directory = include.username | prepend: '/assets/img/trophies/' | append: '/' %}
{% assign color_modes = 'light,dark' | split: ',' %}
<div class="repo p-2 text-center">
  <a href="https://github.com/ryo-ma/github-profile-trophy">
    {% for mode in color_modes %}
      {% assign theme_key = mode | prepend: 'theme_' %}
      {% assign trophy_path = trophy_directory | append: site.repo_trophies[theme_key] %}
      <picture class="only-{{ mode }}">
        <source media="(min-width: 768px)" srcset="{{ trophy_path | append: '-6.svg' | relative_url }}">
        <source media="(min-width: 576px)" srcset="{{ trophy_path | append: '-4.svg' | relative_url }}">
        <img class="d-block" src="{{ trophy_path | append: '-3.svg' | relative_url }}" alt="GitHub trophies for {{ include.username | escape }}">
      </picture>
    {% endfor %}
  </a>
</div>
